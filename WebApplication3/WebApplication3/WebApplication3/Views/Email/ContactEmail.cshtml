@model WebApplication3.Controllers.ContactRequest
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>@ViewData["EmailTitle"]</title>
    <!--[if mso]>
    <noscript>
    <xml>
    <o:OfficeDocumentSettings>
    <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
    </xml>
    </noscript>
    <![endif]-->
    <style>
        @@media only screen and (max-width: 600px) {
            .section-padding {
                padding-left: 10px !important;
                padding-right: 10px !important;
            }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f4; font-family: Arial, sans-serif; -webkit-font-smoothing: antialiased; font-size: 16px; line-height: 1.4; -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="table-layout: fixed;">
        <tr>
            <td align="center" style="padding: 0;">
                <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" width="600" style="background-color: #ffffff; margin: 0 auto; max-width: 600px; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
                    <!-- Header -->
                    <tr>
                        <td align="center" style="padding: 30px 0; background-color: #007bff;">
                            <img src="https://i.postimg.cc/W4spdM3n/logo-2.png" alt="HoLiHu Logo" style="display: block; height: 125px; width: auto; max-width: 100%;">
                        </td>
                    </tr>
                    <!-- Blue Gradient Line -->
                    <tr>
                        <td style="padding: 0;">
                            <img src="https://ci3.googleusercontent.com/meips/ADKq_NYdZ75rCQHEXYOXoBZWl7ryQLKSdGuTZLG_SLR9_DIDl637OdRhWq5uTYqs7UpEh451qYsQo-hznN3ssW9owQ5tkmrcBZFg82vwyC7L0D1w8eJDQR8-wV0WUDszhJ1AXcR1mPRT8ZyPDn0MxQucu_k=s0-d-e1-ft#https://cdn.oreillystatic.com/oreilly/email/odot-template/em_gradient_line_ocean_600x4.png" alt="" style="display: block; width: 100%; height: 4px;">
                        </td>
                    </tr>
                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 30px;" class="section-padding">
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td style="padding: 0 0 30px 0; text-align: center;">
                                        <h1 style="margin: 0; font-size: 28px; line-height: 36px; color: #333333; font-weight: bold;">
                                            Yêu cầu liên hệ mới từ khách hàng
                                        </h1>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 0 0 20px 0;">
                                        <p style="margin: 0; font-size: 18px; line-height: 28px; color: #333333;">
                                            Kính gửi <strong>Đội ngũ Hỗ trợ Holihu</strong>,
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 0 0 20px 0;">
                                        <p style="margin: 0; font-size: 16px; line-height: 24px; color: #555555;">
                                            Hệ thống Holihu vừa tiếp nhận một yêu cầu liên hệ mới từ khách hàng. Vui lòng xem xét chi tiết bên dưới và phản hồi trong thời gian sớm nhất để đảm bảo chất lượng dịch vụ.
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 20px 0;">
                                        <h2 style="margin: 0 0 10px 0; font-size: 20px; line-height: 28px; color: #333333;">Chi tiết yêu cầu:</h2>
                                        <ul style="margin: 0; padding-left: 20px; font-size: 16px; line-height: 24px; color: #555555;">
                                            <li><strong>Ngày gửi:</strong> @DateTime.Now.ToString("dd/MM/yyyy")</li>
                                            <li><strong>Khách hàng:</strong> @Model.Email</li>
                                            <li><strong>Lý do liên hệ:</strong> @ViewData["LyDo"]</li>
                                            <li><strong>Nội dung yêu cầu:</strong><br><em>"@Model.GhiChu"</em></li>
                                        </ul>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 20px 0;">
                                        <h2 style="margin: 0 0 10px 0; font-size: 20px; line-height: 28px; color: #333333;">Trạng thái xử lý:</h2>
                                        <ul style="margin: 0; padding-left: 20px; font-size: 16px; line-height: 24px; color: #555555;">
                                            <li><strong>Xác nhận tiếp nhận:</strong> Email tự động đã được gửi đến khách hàng để xác nhận Holihu đã tiếp nhận yêu cầu.</li>
                                            <li><strong>Phản hồi khách hàng:</strong> Đội ngũ hỗ trợ cần liên hệ lại trong vòng <strong>24 giờ</strong> để đảm bảo trải nghiệm khách hàng tốt nhất.</li>
                                        </ul>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 20px 0;">
                                        <h2 style="margin: 0 0 10px 0; font-size: 20px; line-height: 28px; color: #333333;">Hướng dẫn xử lý:</h2>
                                        <ol style="margin: 0; padding-left: 20px; font-size: 16px; line-height: 24px; color: #555555;">
                                            <li><strong>Kiểm tra thông tin yêu cầu:</strong> Truy cập hệ thống CRM để xem chi tiết.</li>
                                            <li><strong>Xác định phương án phản hồi:</strong> Đảm bảo câu trả lời chính xác, đầy đủ và chuyên nghiệp.</li>
                                            <li><strong>Gửi phản hồi khách hàng:</strong> Sử dụng email hoặc tổng đài phù hợp để liên hệ với khách hàng.</li>
                                            <li><strong>Cập nhật trạng thái:</strong> Đánh dấu yêu cầu là "Đã xử lý" hoặc "Đang theo dõi" trên hệ thống sau khi liên hệ.</li>
                                        </ol>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 20px 0 0 0;">
                                        <p style="margin: 0; font-size: 16px; line-height: 24px; color: #555555;">
                                            Nếu cần hỗ trợ hoặc có bất kỳ vấn đề phát sinh, vui lòng báo cáo ngay cho quản lý trực tiếp để được hướng dẫn.
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 20px 0;">
                                        <h2 style="margin: 0 0 10px 0; font-size: 20px; line-height: 28px; color: #333333;">Cam kết dịch vụ:</h2>
                                        <p style="margin: 0; font-size: 16px; line-height: 24px; color: #555555;">
                                            Holihu cam kết mang đến trải nghiệm dịch vụ khách hàng xuất sắc. Việc phản hồi kịp thời và chuyên nghiệp sẽ giúp củng cố uy tín thương hiệu và nâng cao sự hài lòng của khách hàng.
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 30px 0 0 0;">
                                        <p style="margin: 0; font-size: 16px; line-height: 24px; color: #333333;">
                                            Trân trọng,<br>
                                            <strong>Hệ thống Holihu</strong>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <!-- Footer -->
                    <tr>
                        <td style="padding: 30px; background-color: #f8f9fa; text-align: center;">
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td style="padding: 0 0 20px 0;">
                                        <!-- Social Media Icons -->
                                        <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 0 auto;">
                                            <tr>
                                                <td style="padding: 0 10px;">
                                                    <a href="https://twitter.com/holihu" target="_blank" style="text-decoration: none;">
                                                        <img src="https://cdn.oreillystatic.com/oreilly/email/odot-template/em_icon_twitter.png" alt="Twitter" width="24" height="24" style="display: block; border: 0;">
                                                    </a>
                                                </td>
                                                <td style="padding: 0 10px;">
                                                    <a href="https://linkedin.com/company/holihu" target="_blank" style="text-decoration: none;">
                                                        <img src="https://cdn.oreillystatic.com/oreilly/email/odot-template/em_icon_linkedIn.png" alt="LinkedIn" width="24" height="24" style="display: block; border: 0;">
                                                    </a>
                                                </td>
                                                <td style="padding: 0 10px;">
                                                    <a href="https://youtube.com/holihu" target="_blank" style="text-decoration: none;">
                                                        <img src="https://cdn.oreillystatic.com/oreilly/email/odot-template/em_icon_youtube.png" alt="YouTube" width="24" height="24" style="display: block; border: 0;">
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 0;">
                                        <!-- Footer Text -->
                                        <p style="margin: 0 0 10px 0; font-size: 14px; line-height: 22px; color: #666666;">
                                            © @DateTime.Now.Year Holihu. Mọi quyền được bảo lưu.
                                        </p>
                                        <p style="margin: 0 0 10px 0; font-size: 14px; line-height: 22px; color: #666666;">
                                            <a href="https://www.holihu.com" style="color: #007bff; text-decoration: none;">www.holihu.com</a> |
                                            <a href="https://www.holihu.com/privacy" style="color: #007bff; text-decoration: none;">Chính sách bảo mật</a> |
                                            <a href="https://www.holihu.com/terms" style="color: #007bff; text-decoration: none;">Điều khoản dịch vụ</a>
                                        </p>
                                        <p style="margin: 0; font-size: 12px; line-height: 18px; color: #999999;">
                                            Đây là email tự động, vui lòng không trả lời thư này.<br>
                                            Nếu cần hỗ trợ, liên hệ: <a href="mailto:support@holihu.com" style="color: #007bff; text-decoration: none;">support@holihu.com</a> | [Số điện thoại hỗ trợ]
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>