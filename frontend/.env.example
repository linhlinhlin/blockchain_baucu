# ──────────────────────────────────────────────
#  frontend/.env.example  –  copy to .env và điền giá trị thực
#  File này an toàn để commit (không chứa secrets)
# ──────────────────────────────────────────────

HTTPS=true
SSL_CRT_FILE=./localhost.pem
SSL_KEY_FILE=./localhost-key.pem

# reCAPTCHA v3 Site Key (public – an toàn để commit)
SITE_KEY=

# Backend API
VITE_API_BASE_URL=https://localhost:7250

# Blockchain RPC
VITE_RPC_URL=https://geth.holihu.online
VITE_BUNDLER_URL=http://localhost:5000/api/bundler
VITE_ENTRY_POINT_ADDRESS=

# Contract addresses (Sepolia testnet)
VITE_FACTORY_ADDRESS=
VITE_HLU_TOKEN_ADDRESS=
VITE_PAYMASTER_ADDRESS=

# TinyMCE (lấy tại https://www.tiny.cloud/)
NEXT_PUBLIC_TINYMCE_API_KEY=
