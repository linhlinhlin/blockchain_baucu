# Root .env cho docker-compose.active.yml — copy thanh `.env` (da gitignored), dien gia tri.
# KHONG commit `.env`. Day la cac bien duoc compose thay the (${VAR}).

# JWT signing secret — BAT BUOC, >=32 ky tu ngau nhien.
# Sinh: openssl rand -base64 48   (hoac PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256})))
# Backend fail-fast neu thieu/qua ngan (spec 001 / S3).
JWT_SECRET=

# reCAPTCHA v3 - local stack mac dinh tat. Chi bat khi da co key that tu Google reCAPTCHA Admin.
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
VITE_RECAPTCHA_ENABLED=false
